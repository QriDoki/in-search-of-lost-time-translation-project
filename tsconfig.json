{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": [
    "site/.vitepress/theme/composables/user-storage/**/*.ts",
    "site/.vitepress/theme/composables/reader.ts",
    "site/.vitepress/theme/composables/book.ts",
    "site/.vitepress/theme/composables/usePopoverPosition.ts",
    "site/.vitepress/theme/composables/useToasts.ts",
    "site/.vitepress/theme/composables/useSelection.ts",
    "tests/storage/**/*.ts",
    "tests/components/**/*.ts",
    "tests/setup.ts",
    "tests/globals.d.ts",
    "vitest.config.ts"
  ]
}